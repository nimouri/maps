{
  "manifest_version": 3,
  "name": "MapCareer Google Maps Bridge",
  "version": "1.0.0",
  "description": "Live Google Maps scraper bridge for MapCareer. Discovers real businesses with zero paid APIs.",
  "permissions": [],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.de/maps/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://YOUR-DOMAIN-HERE/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.de/maps/*"
      ],
      "js": ["parsing.js", "content-maps.js"],
      "run_at": "document_idle"
    }
  ]
}
